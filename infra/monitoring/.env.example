# Copy to infra/monitoring/.env before running `docker compose up -d`
# Do NOT commit infra/monitoring/.env to Git.

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-this-local-grafana-password

# Host FastAPI scrape target reachable from Docker Desktop/Engine containers
FASTAPI_SCRAPE_TARGET=host.docker.internal:8000

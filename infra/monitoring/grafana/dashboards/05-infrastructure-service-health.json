{
  "uid": "sentinel-infra-health",
  "title": "LLMOps Sentinel — 05 Infrastructure & Service Health",
  "tags": ["llmops-sentinel", "infrastructure", "health"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Status (FastAPI / Chroma / Ollama / MLflow)",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "llmops_sentinel_service_up",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP" }, "0": { "text": "DOWN" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Backend Uptime (seconds)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "llmops_sentinel_process_uptime_seconds" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Indexed Documents / Chunks",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "llmops_sentinel_chromadb_documents", "legendFormat": "Docs" },
        { "refId": "B", "expr": "llmops_sentinel_chromadb_chunks", "legendFormat": "Chunks" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ollama Models & Embed Cache Entries",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "llmops_sentinel_ollama_models_available", "legendFormat": "Models" },
        { "refId": "B", "expr": "llmops_sentinel_embedding_cache_entries", "legendFormat": "Cache" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "FastAPI Process RSS Memory (MB)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "llmops_sentinel_process_memory_rss_bytes / 1048576",
          "legendFormat": "RSS Memory (MB)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "megabytes" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "FastAPI Process CPU Utilization (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "llmops_sentinel_process_cpu_percent",
          "legendFormat": "Process CPU %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dependency Health Probe Latency (s)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(llmops_sentinel_dependency_check_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}} P95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}

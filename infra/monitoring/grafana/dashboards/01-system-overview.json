{
  "uid": "sentinel-system-overview",
  "title": "LLMOps Sentinel — 01 System Overview",
  "tags": ["llmops-sentinel", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API Request Rate (req/s)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(llmops_sentinel_http_requests_total[5m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx Server Error Ratio (%)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(llmops_sentinel_http_errors_total{status_class=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate(llmops_sentinel_http_requests_total[5m])), 0.001)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "RAG /query P95 Latency (s)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llmops_sentinel_http_request_duration_seconds_bucket{route=\"/query\"}[5m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "In-Flight HTTP & Active Evals",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(llmops_sentinel_http_requests_in_flight)", "legendFormat": "HTTP In-Flight" },
        { "refId": "B", "expr": "llmops_sentinel_eval_jobs_active", "legendFormat": "Active Judge Eval" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Rate by Route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(llmops_sentinel_http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "RAG /query Latency Percentiles (P50 & P95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(llmops_sentinel_http_request_duration_seconds_bucket{route=\"/query\"}[5m])))",
          "legendFormat": "P50 Latency"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llmops_sentinel_http_request_duration_seconds_bucket{route=\"/query\"}[5m])))",
          "legendFormat": "P95 Latency"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Service Dependency Health (1 = UP, 0 = DOWN)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "llmops_sentinel_service_up",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } }
    }
  ]
}

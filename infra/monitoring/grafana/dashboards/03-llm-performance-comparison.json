{
  "uid": "sentinel-llm-performance",
  "title": "LLMOps Sentinel — 03 LLM Performance & Model Comparison",
  "tags": ["llmops-sentinel", "llm", "ollama"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Latest Throughput by Model (tok/s)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "llmops_sentinel_llm_last_tokens_per_second",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 2 } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Completion Tokens Generated",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, token_source) (llmops_sentinel_llm_tokens_generated_total)",
          "legendFormat": "{{model}} ({{token_source}})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Interactive LLM Requests",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "llmops_sentinel_llm_active_requests",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Generation Latency by Model (P50 & P95 seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(llmops_sentinel_llm_generation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}} P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llmops_sentinel_llm_generation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{model}} P95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token Throughput Average (tok/s) by Model",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(llmops_sentinel_llm_tokens_per_second_sum[5m])) / clamp_min(sum by (model) (rate(llmops_sentinel_llm_tokens_per_second_count[5m])), 0.001)",
          "legendFormat": "{{model}} avg tok/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM Calls by Model, Endpoint & Outcome",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "llmops_sentinel_llm_requests_total",
          "legendFormat": "{{model}} / {{endpoint}} ({{status}})"
        }
      ]
    }
  ]
}
